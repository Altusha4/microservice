# ##############################
# REDIS
# ##############################
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ##############################
# ORDER SERVICE
# ##############################
ORDER_CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MIN=10

# ##############################
# NOTIFICATION SERVICE
# ##############################
NOTIFICATION_IDEMPOTENCY_TTL_SECONDS=86400
EMAIL_MAX_RETRIES=3
EMAIL_BACKOFF_BASE_MS=2000

PROVIDER_MODE=SIMULATED

SIMULATOR_LATENCY_MS=200
SIMULATOR_FAILURE_RATE=0.3

# Mailtrap sandbox — get yours at https://mailtrap.io/sandboxes
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@microservice.local